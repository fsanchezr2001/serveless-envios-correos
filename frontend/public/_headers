# Angular hashes every build artifact (outputHashing: "all"), so assets are
# immutable and can be cached aggressively. index.html must never be cached,
# otherwise clients keep loading an old bundle after a deploy.

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
